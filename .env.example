# Public environment variables (Expo)

# Copy to `.env` for local development. Never commit real production values.

# --- Analytics (Phase 5A) ---

# AppMetrica application API key from https://appmetrica.yandex.com/
# This is a client-embedded application identifier, not a private server secret,
# but production keys still must not be committed to git.
EXPO_PUBLIC_APPMETRICA_API_KEY=your-dev-appmetrica-key

# When "true", DevAnalyticsService-style console logging preference is forced.
# In __DEV__ analytics still has a separate path; for store/release builds keep false.
EXPO_PUBLIC_ANALYTICS_DEV_MODE=false

# --- Advertising (Phase 5C / Phase 6) ---

# Production Yandex ad unit IDs from the partner console (R-M-…).
# In __DEV__ the app ALWAYS uses official demo units
# (demo-banner-yandex / demo-rewarded-yandex) to avoid paid impressions.
# In production builds, empty/malformed values disable ads (fail open).
EXPO_PUBLIC_YANDEX_ADS_BANNER_UNIT_ID=
EXPO_PUBLIC_YANDEX_ADS_REWARDED_UNIT_ID=

# Optional legacy aliases (still read by env.ts):
# EXPO_PUBLIC_YANDEX_BANNER_BLOCK_ID=
# EXPO_PUBLIC_YANDEX_REWARDED_BLOCK_ID=
