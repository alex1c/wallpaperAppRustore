# Public environment variables (Expo)

# Copy to `.env` for local development. Never commit real production values.

# --- Analytics (Phase 5A) ---

# AppMetrica application API key from https://appmetrica.yandex.com/
# This is a client-embedded application identifier, not a private server secret,
# but production keys still must not be committed to git.
EXPO_PUBLIC_APPMETRICA_API_KEY=your-dev-appmetrica-key

# When "true", DevAnalyticsService logs events to the console.
# In __DEV__ this defaults to enabled even if unset.
EXPO_PUBLIC_ANALYTICS_DEV_MODE=true

# --- Advertising (Phase 6+, NOT used in Phase 5A) ---

# Yandex ad block IDs — placeholders only; ads are not implemented yet
EXPO_PUBLIC_YANDEX_BANNER_BLOCK_ID=demo-banner-block-id
EXPO_PUBLIC_YANDEX_INTERSTITIAL_BLOCK_ID=demo-interstitial-block-id
EXPO_PUBLIC_YANDEX_REWARDED_BLOCK_ID=demo-rewarded-block-id
