# Copy this file to credentials/keystore.properties (gitignored) AFTER you
# generate the production keystore. Never commit the copy with real passwords.
#
# storeFile must be an absolute path to a keystore OUTSIDE the git repo.
# Example Windows path: C:/Users/YOU/secure/calculator-platform/wallpaper-release.jks
# Use forward slashes so Gradle accepts the path on Windows.

storeFile=C:/Users/YOU/secure/calculator-platform/wallpaper-release.jks
storePassword=REPLACE_ME
keyAlias=wallpaper
keyPassword=REPLACE_ME
