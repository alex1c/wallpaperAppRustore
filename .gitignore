.env
.env.local
.env.*.local
.package.json.pre-production-backup

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts
*.apk
*.aab
*.ipa
/release-artifacts/
/release-assets/

# Android Studio / IDE local files
.idea/
*.iml
local.properties

# test coverage
coverage/
